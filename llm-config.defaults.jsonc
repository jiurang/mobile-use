// Here is the default config that will be used if no override is provided.
{
  "default": {
    // Reporter **故意不写**：这一份是所有用户 override 文件的合并底座。
    // 底座上写死 reporter = openai 的话，任何「按老模板抄的、没写 reporter 的」override
    // 都会让 reporter 独自留在 openai 上（而 executor 已经换到别的供应商），
    // validate_providers() 会直接索要 OPENAI_API_KEY —— 部署起不来。
    // 不写 = 走回落（get_agent("reporter") → executor），永远跟着 executor 的渠道走。
    // 要显式配就在这个对象里加 "reporter": { ... }，另外 4 个 preset 里都有写法示例。
    "planner": {
      "provider": "openai",
      "model": "gpt-5-nano",
      "fallback": {
        "provider": "openai",
        "model": "gpt-5-mini"
      }
    },
    // Orchestrator 是看门狗：每子目标判一次「计划还走得通吗」，是高层判断 → 升到强模型
    // （doc/executor-autonomy-plan.md §2.1.1）。频次低（每子目标 1 次），所以成本可控。
    "orchestrator": {
      "provider": "openai",
      "model": "gpt-5",
      "fallback": {
        "provider": "openai",
        "model": "o4-mini"
      }
    },
    "cortex": {
      "provider": "openai",
      "model": "gpt-5",
      "fallback": {
        "provider": "openai",
        "model": "o4-mini"
      }
    },
    "executor": {
      "provider": "openai",
      "model": "gpt-5-nano",
      "fallback": {
        "provider": "openai",
        "model": "gpt-5-mini"
      }
    },
    "contextor": {
      "provider": "openai",
      "model": "gpt-5-nano",
      "fallback": {
        "provider": "openai",
        "model": "gpt-5-mini"
      }
    },
    "utils": {
      "hopper": {
        // Needs at least a 256k context window.
        "provider": "openai",
        "model": "gpt-5-nano",
        "fallback": {
          "provider": "openai",
          "model": "gpt-5-mini"
        }
      },
      "outputter": {
        "provider": "openai",
        "model": "gpt-5-nano",
        "fallback": {
          "provider": "openai",
          "model": "gpt-5-mini"
        }
      }
      // video_analyzer is optional - only needed when using video recording tools
      // Requires a video-capable model (Google). To enable, uncomment below:
      // "video_analyzer": {
      //   "provider": "google",
      //   "model": "gemini-3-flash-preview",
      //   "fallback": {
      //     "provider": "google",
      //     "model": "gemini-2.5-flash"
      //   }
      // }
    }
  },
  // Anthropic preset – uses Claude Sonnet 4.6 (capable, 200k context) with Haiku 4.5 as a
  // fast/cheap fallback. To use it, copy the contents of this object into llm-config.override.jsonc.
  "anthropic": {
    "planner": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-20251001"
      }
    },
    "orchestrator": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-20251001"
      }
    },
    "cortex": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-20251001"
      }
    },
    "executor": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5-20251001",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6"
      }
    },
    // Reporter：只写摘要 + 挑证据，快模型就够 —— 与 executor 同档（§2.1.1）。
    "reporter": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5-20251001",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6"
      }
    },
    "contextor": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5-20251001",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6"
      }
    },
    "utils": {
      "hopper": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6",
        "fallback": {
          "provider": "anthropic",
          "model": "claude-haiku-4-5-20251001"
        }
      },
      "outputter": {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-20251001",
        "fallback": {
          "provider": "anthropic",
          "model": "claude-sonnet-4-6"
        }
      }
    }
  },
  // MiniMax preset – uses MiniMax M2.7 and M2.7-highspeed (200k context).
  // To use it, copy the contents of this object into llm-config.override.jsonc.
  "minimax": {
    "planner": {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3.1-Flash-Preview"
        }
      },
      "orchestrator": {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3.1-Flash-Preview"
        }
      },
      "cortex": {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3.1-Flash-Preview"
        }
      },
      "executor": {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3.1-Flash-Preview"
        }
      },
      // Reporter：只写摘要 + 挑证据，快模型就够（§2.1.1）。
      // 这个 preset 里快/慢的方向和别的角色相反（别的角色是 M3 主、Flash 兜底）：
      // Reporter 摆快模型在前 —— 它是本 preset 里要求最低、却每子目标都要跑一次的角色，
      // 主模型失败时再由 M3 接手。
      "reporter": {
        "provider": "minimax",
        "model": "MiniMax-M3.1-Flash-Preview",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3"
        }
      },
      "contextor": {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3.1-Flash-Preview"
        }
      },
      "utils": {
        "hopper": {
          "provider": "minimax",
          "model": "MiniMax-M3",
          "fallback": {
            "provider": "minimax",
            "model": "MiniMax-M3.1-Flash-Preview"
          }
        },
        "outputter": {
          "provider": "minimax",
          "model": "MiniMax-M3",
          "fallback": {
            "provider": "minimax",
            "model": "MiniMax-M3.1-Flash-Preview"
          }
        },
        "video_analyzer": null
      }
  },
  // DeepSeek preset – domestic platform (platform.deepseek.com), 1M context on both models.
  // To use it, copy the contents of this object into llm-config.override.jsonc.
  // Note: DeepSeek answers in "thinking mode" by default (CoT in reasoning_content).
  // Set DEEPSEEK_THINKING=false in .env to trade that reasoning for lower latency/cost.
  "deepseek": {
    "planner": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    // Orchestrator 是看门狗（每子目标判一次「计划还走得通吗」），是高层判断 → 升到强模型
    // deepseek-v4-pro。兜底仍是 flash：orchestrator 只读计划与汇报，不看屏幕，
    // 文本模型够用，万一 v4-pro 不可用还能继续跑。
    "orchestrator": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    "cortex": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    "executor": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    // Reporter：只写摘要 + 挑证据，快模型就够（§2.1.1）→ 与 preset 里其它角色同档。
    "reporter": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    "contextor": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    "utils": {
      "hopper": {
        // Needs at least a 256k context window; both DeepSeek models do 1M.
        "provider": "deepseek",
        "model": "deepseek-flash",
        "fallback": {
          "provider": "deepseek",
          "model": "deepseek-flash"
        }
      },
      "outputter": {
        "provider": "deepseek",
        "model": "deepseek-flash",
        "fallback": {
          "provider": "deepseek",
          "model": "deepseek-flash"
        }
      }
    }
  },
  // SiliconFlow preset – 硅基流动（国内 OpenAI 兼容平台，platform.siliconflow.cn）。
  // To use it, copy the contents of this object into llm-config.override.jsonc.
  //
  // ⚠️ 这个平台**没有一个模型能同时做到「看图 + 发工具调用 + 结构化输出」**，
  // 所以视觉角色必须拆开（能力矩阵都是对着真实 API 核过的，2026-10-21）：
  //
  //   模型                        视觉   工具调用   json_schema 结构化输出
  //   zai-org/GLM-4.5V            ✔      ✔          ✘ 400「Json mode is not supported」
  //   Qwen/Qwen3-VL-32B-Instruct   ✔      ✘ 空内容   ✔
  //   Qwen/Qwen3-VL-8B-Instruct    ✔      ✘ 空内容   ✔
  //   Qwen/Qwen2.5-72B-Instruct    ✘      ✔          ✔
  //   Qwen/Qwen2.5-7B-Instruct     ✘      ✔          ✔
  //
  // 于是：**executor 走 GLM-4.5V**（它要点击，必须能看图 + 调工具），
  // **cortex 走 Qwen3-VL**（它要读屏 + 回结构化决策），其余角色走文本模型。
  // 把 cortex 和 executor 指到同一个模型上必然有一边瞎掉。
  //
  // 另外两点实测结论：
  //   - 视觉模型不支持**强制** tool_choice（400「Specifying functions for
  //     tool_choice is not yet supported」），所以结构化输出走 response_format；
  //   - temperature 0..2 都收，hopper 写死的 0 不用改。
  "siliconflow": {
    "planner": {
      "provider": "siliconflow",
      "model": "Qwen/Qwen2.5-72B-Instruct",
      "fallback": {
        "provider": "siliconflow",
        "model": "Qwen/Qwen2.5-7B-Instruct"
      }
    },
    // Orchestrator 是看门狗（每子目标判一次「计划还走得通吗」），是高层判断 → 强模型。
    "orchestrator": {
      "provider": "siliconflow",
      "model": "Qwen/Qwen2.5-72B-Instruct",
      "fallback": {
        "provider": "siliconflow",
        "model": "Qwen/Qwen2.5-7B-Instruct"
      }
    },
    // Cortex 要读屏 + 回结构化决策 → 视觉 + json_schema ⇒ Qwen3-VL。
    // （不能指到 GLM-4.5V：它不支持 json 模式。）
    "cortex": {
      "provider": "siliconflow",
      "model": "Qwen/Qwen3-VL-32B-Instruct",
      "fallback": {
        "provider": "siliconflow",
        "model": "Qwen/Qwen2.5-72B-Instruct"
      }
    },
    // Executor 是唯一看屏幕**并点击**的角色 → 视觉 + 工具调用 ⇒ GLM-4.5V。
    // 指到 Qwen3-VL 会拿到空内容（模型不调工具），executor 直接卡死。
    "executor": {
      "provider": "siliconflow",
      "model": "zai-org/GLM-4.5V",
      "fallback": {
        "provider": "siliconflow",
        "model": "Qwen/Qwen2.5-72B-Instruct"
      }
    },
    // Reporter：只写摘要 + 挑证据，快模型就够（§2.1.1）→ 与 executor 同档。
    "reporter": {
      "provider": "siliconflow",
      "model": "Qwen/Qwen2.5-7B-Instruct",
      "fallback": {
        "provider": "siliconflow",
        "model": "Qwen/Qwen2.5-72B-Instruct"
      }
    },
    "contextor": {
      "provider": "siliconflow",
      "model": "Qwen/Qwen2.5-7B-Instruct",
      "fallback": {
        "provider": "siliconflow",
        "model": "Qwen/Qwen2.5-72B-Instruct"
      }
    },
    "utils": {
      // Hopper 的温度被调用点写死成 0（可复现），这里别去覆盖它。
      "hopper": {
        "provider": "siliconflow",
        "model": "Qwen/Qwen2.5-7B-Instruct",
        "fallback": {
          "provider": "siliconflow",
          "model": "Qwen/Qwen2.5-72B-Instruct"
        }
      },
      "outputter": {
        "provider": "siliconflow",
        "model": "Qwen/Qwen2.5-7B-Instruct",
        "fallback": {
          "provider": "siliconflow",
          "model": "Qwen/Qwen2.5-72B-Instruct"
        }
      },
      "video_analyzer": null
    }
  },
  // This is the config we recommend.
  // To use it, copy it to llm-config.override.jsonc, following llm-config.override.template.jsonc.
  "recommended": {
    "planner": {
      "provider": "minitap",
      "model": "meta-llama/llama-4-scout",
      "fallback": {
        "provider": "minitap",
        "model": "meta-llama/llama-4-maverick"
      }
    },
    // Orchestrator 是看门狗（每子目标判一次「计划还走得通吗」），是高层判断 → 升到强模型，
    // 与 cortex 同档（§2.1.1）。兜底也跟 cortex 一致。
    "orchestrator": {
      "provider": "minitap",
      "model": "google/gemini-3-pro-preview",
      "fallback": {
        "provider": "minitap",
        "model": "google/gemini-2.5-pro"
      }
    },
    "cortex": {
      "provider": "minitap",
      "model": "google/gemini-3-pro-preview",
      "fallback": {
        "provider": "minitap",
        "model": "google/gemini-2.5-pro"
      }
    },
    "executor": {
      "provider": "minitap",
      "model": "meta-llama/llama-3.1-70b-instruct",
      "fallback": {
        "provider": "minitap",
        "model": "openai/gpt-5-mini"
      }
    },
    // Reporter：只写摘要 + 挑证据，快模型就够（§2.1.1）→ 与 executor 同档。
    "reporter": {
      "provider": "minitap",
      "model": "meta-llama/llama-3.1-70b-instruct",
      "fallback": {
        "provider": "minitap",
        "model": "openai/gpt-5-mini"
      }
    },
    "contextor": {
      "provider": "minitap",
      "model": "meta-llama/llama-3.1-8b-instruct",
      "fallback": {
        "provider": "minitap",
        "model": "meta-llama/llama-3.3-70b-instruct"
      }
    },
    "utils": {
      "hopper": {
        // Needs at least a 256k context window.
        "provider": "minitap",
        "model": "openai/gpt-5-nano",
        "fallback": {
          "provider": "minitap",
          "model": "openai/gpt-5-mini"
        }
      },
      "outputter": {
        "provider": "minitap",
        "model": "openai/gpt-5-nano",
        "fallback": {
          "provider": "minitap",
          "model": "openai/gpt-5-mini"
        }
      },
      // video_analyzer is optional - only needed when using video recording tools
      // Requires a video-capable model. Ex of supported models:
      // gemini-3-pro-preview, gemini-3-flash-preview, gemini-2.5-flash,
      // gemini-2.5-flash-lite, gemini-2.5-pro, gemini-2.0-flash, gemini-2.0-flash-lite
      "video_analyzer": {
        "provider": "minitap",
        "model": "google/gemini-3-flash-preview",
        "fallback": {
          "provider": "minitap",
          "model": "google/gemini-2.5-flash"
        }
      }
    }
  }
}
