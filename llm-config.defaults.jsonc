// Here is the default config that will be used if no override is provided.
{
  "default": {
    "planner": {
      "provider": "openai",
      "model": "gpt-5-nano",
      "fallback": {
        "provider": "openai",
        "model": "gpt-5-mini"
      }
    },
    "orchestrator": {
      "provider": "openai",
      "model": "gpt-5-nano",
      "fallback": {
        "provider": "openai",
        "model": "gpt-5-mini"
      }
    },
    "cortex": {
      "provider": "openai",
      "model": "gpt-5",
      "fallback": {
        "provider": "openai",
        "model": "o4-mini"
      }
    },
    "executor": {
      "provider": "openai",
      "model": "gpt-5-nano",
      "fallback": {
        "provider": "openai",
        "model": "gpt-5-mini"
      }
    },
    "contextor": {
      "provider": "openai",
      "model": "gpt-5-nano",
      "fallback": {
        "provider": "openai",
        "model": "gpt-5-mini"
      }
    },
    "utils": {
      "hopper": {
        // Needs at least a 256k context window.
        "provider": "openai",
        "model": "gpt-5-nano",
        "fallback": {
          "provider": "openai",
          "model": "gpt-5-mini"
        }
      },
      "outputter": {
        "provider": "openai",
        "model": "gpt-5-nano",
        "fallback": {
          "provider": "openai",
          "model": "gpt-5-mini"
        }
      }
      // video_analyzer is optional - only needed when using video recording tools
      // Requires a video-capable model (Google). To enable, uncomment below:
      // "video_analyzer": {
      //   "provider": "google",
      //   "model": "gemini-3-flash-preview",
      //   "fallback": {
      //     "provider": "google",
      //     "model": "gemini-2.5-flash"
      //   }
      // }
    }
  },
  // Anthropic preset – uses Claude Sonnet 4.6 (capable, 200k context) with Haiku 4.5 as a
  // fast/cheap fallback. To use it, copy the contents of this object into llm-config.override.jsonc.
  "anthropic": {
    "planner": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-20251001"
      }
    },
    "orchestrator": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-20251001"
      }
    },
    "cortex": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-20251001"
      }
    },
    "executor": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5-20251001",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6"
      }
    },
    "contextor": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5-20251001",
      "fallback": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6"
      }
    },
    "utils": {
      "hopper": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6",
        "fallback": {
          "provider": "anthropic",
          "model": "claude-haiku-4-5-20251001"
        }
      },
      "outputter": {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-20251001",
        "fallback": {
          "provider": "anthropic",
          "model": "claude-sonnet-4-6"
        }
      }
    }
  },
  // MiniMax preset – uses MiniMax M2.7 and M2.7-highspeed (200k context).
  // To use it, copy the contents of this object into llm-config.override.jsonc.
  "minimax": {
    "planner": {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3.1-Flash-Preview"
        }
      },
      "orchestrator": {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3.1-Flash-Preview"
        }
      },
      "cortex": {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3.1-Flash-Preview"
        }
      },
      "executor": {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3.1-Flash-Preview"
        }
      },
      "contextor": {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback": {
          "provider": "minimax",
          "model": "MiniMax-M3.1-Flash-Preview"
        }
      },
      "utils": {
        "hopper": {
          "provider": "minimax",
          "model": "MiniMax-M3",
          "fallback": {
            "provider": "minimax",
            "model": "MiniMax-M3.1-Flash-Preview"
          }
        },
        "outputter": {
          "provider": "minimax",
          "model": "MiniMax-M3",
          "fallback": {
            "provider": "minimax",
            "model": "MiniMax-M3.1-Flash-Preview"
          }
        },
        "video_analyzer": null
      }
  },
  // DeepSeek preset – domestic platform (platform.deepseek.com), 1M context on both models.
  // To use it, copy the contents of this object into llm-config.override.jsonc.
  // Note: DeepSeek answers in "thinking mode" by default (CoT in reasoning_content).
  // Set DEEPSEEK_THINKING=false in .env to trade that reasoning for lower latency/cost.
  "deepseek": {
    "planner": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    "orchestrator": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    "cortex": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    "executor": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    "contextor": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallback": {
        "provider": "deepseek",
        "model": "deepseek-flash"
      }
    },
    "utils": {
      "hopper": {
        // Needs at least a 256k context window; both DeepSeek models do 1M.
        "provider": "deepseek",
        "model": "deepseek-flash",
        "fallback": {
          "provider": "deepseek",
          "model": "deepseek-flash"
        }
      },
      "outputter": {
        "provider": "deepseek",
        "model": "deepseek-flash",
        "fallback": {
          "provider": "deepseek",
          "model": "deepseek-flash"
        }
      }
    }
  },
  // This is the config we recommend.
  // To use it, copy it to llm-config.override.jsonc, following llm-config.override.template.jsonc.
  "recommended": {
    "planner": {
      "provider": "minitap",
      "model": "meta-llama/llama-4-scout",
      "fallback": {
        "provider": "minitap",
        "model": "meta-llama/llama-4-maverick"
      }
    },
    "orchestrator": {
      "provider": "minitap",
      "model": "openai/gpt-oss-120b",
      "fallback": {
        "provider": "minitap",
        "model": "meta-llama/llama-4-maverick"
      }
    },
    "cortex": {
      "provider": "minitap",
      "model": "google/gemini-3-pro-preview",
      "fallback": {
        "provider": "minitap",
        "model": "google/gemini-2.5-pro"
      }
    },
    "executor": {
      "provider": "minitap",
      "model": "meta-llama/llama-3.1-70b-instruct",
      "fallback": {
        "provider": "minitap",
        "model": "openai/gpt-5-mini"
      }
    },
    "contextor": {
      "provider": "minitap",
      "model": "meta-llama/llama-3.1-8b-instruct",
      "fallback": {
        "provider": "minitap",
        "model": "meta-llama/llama-3.3-70b-instruct"
      }
    },
    "utils": {
      "hopper": {
        // Needs at least a 256k context window.
        "provider": "minitap",
        "model": "openai/gpt-5-nano",
        "fallback": {
          "provider": "minitap",
          "model": "openai/gpt-5-mini"
        }
      },
      "outputter": {
        "provider": "minitap",
        "model": "openai/gpt-5-nano",
        "fallback": {
          "provider": "minitap",
          "model": "openai/gpt-5-mini"
        }
      },
      // video_analyzer is optional - only needed when using video recording tools
      // Requires a video-capable model. Ex of supported models:
      // gemini-3-pro-preview, gemini-3-flash-preview, gemini-2.5-flash,
      // gemini-2.5-flash-lite, gemini-2.5-pro, gemini-2.0-flash, gemini-2.0-flash-lite
      "video_analyzer": {
        "provider": "minitap",
        "model": "google/gemini-3-flash-preview",
        "fallback": {
          "provider": "minitap",
          "model": "google/gemini-2.5-flash"
        }
      }
    }
  }
}
