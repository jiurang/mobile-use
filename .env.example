MINITAP_API_KEY="..."

ANTHROPIC_API_KEY='...'

OPENAI_API_KEY='...'
# OPENAI_BASE_URL="https://api.openai.com/v1" # Optional - uncomment to override default

GOOGLE_API_KEY="..."
XAI_API_KEY='...'
OPEN_ROUTER_API_KEY='..'
MINIMAX_API_KEY='...'
DEEPSEEK_API_KEY='...'
# DEEPSEEK_BASE_URL="https://api.deepseek.com" # Optional - domestic platform is the default
# DeepSeek thinks by default (CoT in reasoning_content). Set to "false" to disable:
# DEEPSEEK_THINKING="false"

# SiliconFlow (硅基流动) — 国内 OpenAI 兼容平台
SILICONFLOW_API_KEY='...'
# SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1" # Optional - .cn is the default
# 视觉角色必须用 VL 模型（Qwen/Qwen3-VL-*），纯文本模型看不到截图。

# Azure AI Foundry
# With API key:     AZURE_BASE_URL="https://<resource>.services.ai.azure.com/openai/v1"
# With Entra ID:    AZURE_BASE_URL="https://<resource>.services.ai.azure.com/api/projects/<project>"
# AZURE_API_KEY="..." # Optional - omit to use DefaultAzureCredential

# EVENTS_OUTPUT_PATH="./events.txt" # Optional - path to output events file
# RESULTS_OUTPUT_PATH="./results.txt" # Optional - path to output results file

# Telemetry - set to "false" to disable anonymous usage data collection
# MOBILE_USE_TELEMETRY_ENABLED="true"
